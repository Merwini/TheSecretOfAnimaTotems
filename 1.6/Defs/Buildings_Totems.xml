<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<ThingDef ParentName="BuildingBase" Abstract="True" Name="TSOA_AnimusTotemBase">
		<graphicData>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(2, 2)</drawSize>
			<shadowData>
				<volume>(0.2, 0.35, 0.13)</volume>
				<offset>(0,0,-0.25)</offset>
			</shadowData>
			<drawOffset>(0,0,0.5)</drawOffset>
			<shaderType>CutoutComplex</shaderType>
		</graphicData>
		<statBases>
			<MaxHitPoints>450</MaxHitPoints>
			<Flammability>0</Flammability>
			<Beauty>10</Beauty>
			<WorkToBuild>16000</WorkToBuild>
			<Mass>300</Mass>
		</statBases>
		<designationCategory>Misc</designationCategory>
		<stuffCategories>
			<li>Stony</li>
		</stuffCategories>
		<costStuffCount>75</costStuffCount>
		<costList>
			<Jade>25</Jade>
			<TSOA_AnimaSap>3</TSOA_AnimaSap>
		</costList>
		<minifiedDef>MinifiedThing</minifiedDef>
		<thingCategories>
			<li>BuildingsMisc</li>
		</thingCategories>
		<building>
			<isEdifice>true</isEdifice>
		</building>
		<thingClass>tsoa.totems.Building_AnimusTotem</thingClass>
		<size>(1, 1)</size>
		<fillPercent>1</fillPercent>
		<altitudeLayer>Building</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<pathCost>42</pathCost>
		<canOverlapZones>true</canOverlapZones>
		<tickerType>Normal</tickerType>
		<defaultPlacingRot>North</defaultPlacingRot>
		<comps>
			<li Class="tsoa.core.CompProperties_GroupedFacility">
				<categoryTag>TSOA_AnimusTotemCategory</categoryTag>
				<maxDistance>6</maxDistance>
				<canPlaceWithoutLink>false</canPlaceWithoutLink>
			</li>
			<li Class="CompProperties_Refuelable">
				<fuelConsumptionRate>2.0</fuelConsumptionRate>
				<fuelCapacity>20.0</fuelCapacity>
				<fuelFilter>
					<thingDefs>
						<li>TSOA_AnimaGrassResource</li>
					</thingDefs>
				</fuelFilter>
				<showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
			</li>
		</comps>
		<placeWorkers>
			<li>tsoa.core.PlaceWorker_ShowGroupedFacilitiesConnections</li>
		</placeWorkers>
	</ThingDef>

	<ThingDef ParentName="TSOA_AnimusTotemBase">
		<defName>TSOA_TotemFriendship</defName>
		<label>animus totem of friendship</label>
		<description>A totem of of carved stone and jade, lacquered with anima sap. When linked to an anima tree and fueled with anima grass, taps into the anima radix to emit a worldwide psychic signal. This signal subtly influences other factions to view your colony more favorably.\n\nFor non-permanently hostile factions, increases goodwill by 2 per day, up to a cap of 100 over their natural goodwill.</description>
		<thingClass>tsoa.totems.Building_TotemFriendship</thingClass>
		<graphicData>
			<texPath>Things/Building/Totem/AnimusTotemCapybara</texPath>
		</graphicData>
		<researchPrerequisites>
			<li>TSOA_TotemOne</li>
		</researchPrerequisites>
	</ThingDef>

	<ThingDef ParentName="TSOA_AnimusTotemBase">
		<defName>TSOA_TotemMemory</defName>
		<label>animus totem of memory</label>
		<description>A totem of of carved stone and jade, lacquered with anima sap. When linked to an anima tree and fueled with anima grass, taps into the anima radix to emit a worldwide psychic signal. This signal subtly reminds your colonists of their past accomplishments, keeping their skills sharp.\n\nDecreases your colonists' natural skill loss by half.</description>
		<thingClass>tsoa.totems.Building_TotemMemory</thingClass>
		<graphicData>
			<texPath>Things/Building/Totem/AnimusTotemElephant</texPath>
		</graphicData>
		<researchPrerequisites>
			<li>TSOA_TotemThree</li>
		</researchPrerequisites>
	</ThingDef>

	<ThingDef ParentName="TSOA_AnimusTotemBase">
		<defName>TSOA_TotemTemper</defName>
		<label>animus totem of temper</label>
		<description>A totem of of carved stone and jade, lacquered with anima sap. When linked to an anima tree and fueled with anima grass, taps into the anima radix to emit a worldwide psychic signal. This signal subtly influences your colonists, reminding them of good memories and distracting them from bad ones.\n\nFor your colonists, shortens the duration of negative thought by 50%, increases the duration of positive ones by 50%.</description>
		<thingClass>tsoa.totems.Building_TotemTemper</thingClass>
		<graphicData>
			<texPath>Things/Building/Totem/AnimusTotemDog</texPath>
		</graphicData>
		<researchPrerequisites>
			<li>TSOA_TotemOne</li>
		</researchPrerequisites>
	</ThingDef>

	<ThingDef ParentName="TSOA_AnimusTotemBase">
		<defName>TSOA_TotemBounty</defName>
		<label>animus totem of bounty</label>
		<description>A totem of of carved stone and jade, lacquered with anima sap. When linked to an anima tree and fueled with anima grass, taps into the anima radix to emit a map psychic signal. This signal stimulates plants to grow faster.\n\nIncreases the growth speed of all plants on the same map as the totem by 50%.</description>
		<thingClass>tsoa.totems.Building_TotemBounty</thingClass>
		<graphicData>
			<texPath>Things/Building/Totem/AnimusTotemCow</texPath>
		</graphicData>
		<researchPrerequisites>
			<li>TSOA_TotemTwo</li>
		</researchPrerequisites>
	</ThingDef>

	<ThingDef ParentName="TSOA_AnimusTotemBase">
		<defName>TSOA_TotemPremonition</defName>
		<label>animus totem of premonition</label>
		<description>A totem of of carved stone and jade, lacquered with anima sap. When linked to an anima tree and fueled with anima grass, taps into the anima radix to detect hostile intentions toward your colony. When the fulfillment of these intentions becomes immenent, gives your colony a warning.\n\n Provides a 3-6 hour warning before a raid occurs on the same map as the totem.</description>
		<thingClass>tsoa.totems.Building_TotemPremonition</thingClass>
		<graphicData>
			<texPath>Things/Building/Totem/AnimusTotemEagle</texPath>
		</graphicData>
		<researchPrerequisites>
			<li>TSOA_TotemThree</li>
		</researchPrerequisites>
	</ThingDef>

